# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# YBGP Loyalty Configuration
VITE_APP_ENV="development"
VITE_SMS_PROVIDER_MODE="simulated" # simulated | production
VITE_CURRENCY_SYMBOL="₹"
VITE_DEFAULT_TIMEZONE="Asia/Kolkata"
VITE_YBGP_DOMAIN="https://ybgp.in"
VITE_SUPPORT_EMAIL="support@ybgp.in"
VITE_SUPPORT_PHONE="+919876543210"
