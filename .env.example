# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Server Environment & Production Security
NODE_ENV="development" # Set to 'production' for production deployment
ENABLE_DEMO_SEED="false" # Strictly prohibited and refused when NODE_ENV=production

# Initial Platform Admin Provisioning Secret
BOOTSTRAP_ADMIN_SECRET="your-strong-bootstrap-secret-here"

# Payment Webhook Verification Secrets (Fail closed if missing)
PAYMENT_WEBHOOK_SECRET="your_shared_webhook_secret_here"
RAZORPAY_WEBHOOK_SECRET="your_razorpay_webhook_secret_here"
STRIPE_WEBHOOK_SECRET="whsec_your_stripe_webhook_secret_here"

# SMS OTP Gateways (At least one required when operating in production)
SMS_PROVIDER="gateway" # fast2sms | msg91 | twilio | generic_http | simulated
FAST2SMS_API_KEY="your_fast2sms_api_key_here"
MSG91_AUTH_KEY="your_msg91_auth_key_here"
MSG91_TEMPLATE_ID="your_dlt_template_id_here"
TWILIO_ACCOUNT_SID="ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TWILIO_AUTH_TOKEN="your_twilio_auth_token_here"
TWILIO_FROM="+15005550006"
SMS_GATEWAY_URL="https://your-custom-sms-gateway.com/send"

# Frontend Client Environment Variables
VITE_APP_ENV="development"
VITE_SMS_PROVIDER_MODE="simulated" # simulated | gateway
VITE_CURRENCY_SYMBOL="₹"
VITE_DEFAULT_TIMEZONE="Asia/Kolkata"
VITE_YBGP_DOMAIN="https://ybgp.in"
VITE_SUPPORT_EMAIL="support@ybgp.in"
VITE_SUPPORT_PHONE="+919876543210"
